# ── API ───────────────────────────────────────────────────────────────────────
# Base de la API Laravel. En desarrollo se deja relativa para usar el proxy de
# Vite; en producción puede apuntar a otro origen (ej. https://api.kaffa.com/api/v1).
VITE_API_URL=/api/v1

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Copia este archivo a `.env.local` y ajusta los valores si es necesario.
# cloud_name y upload_preset son públicos (subida "unsigned" desde el navegador);
# el API secret NUNCA debe ir aquí.
#
# La carpeta destino de las imágenes la define el propio upload preset en
# Cloudinary (actualmente: samples/ecommerce).
VITE_CLOUDINARY_CLOUD_NAME=roffd6et
VITE_CLOUDINARY_UPLOAD_PRESET=KAFFACCYS
